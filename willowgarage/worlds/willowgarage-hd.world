<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="willow_garage_world">

    <!-- Core simulation systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

        <scene>
        <grid>false</grid>
        </scene>
            
     <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
      
    <physics name='default_physics' default='0' type='ode'>
        <max_step_size>0.001</max_step_size>
        <!-- <max_step_size>0.0005</max_step_size> -->
        <real_time_factor>1</real_time_factor>
        <!-- 
        To make your simulation run at a normal speed and ensure your ROS 2 topics publish at a reliable, 
        steady frequency, you need to sync the math.
        The calculation is: max_step_size × real_time_update_rate = real_time_factor.
        If you want a target Real Time Factor (RTF) of 1 (real life speed) with a step size of 0.001, 
        your rate must be 1000-->
        <real_time_update_rate>1000</real_time_update_rate>
        <ode>
            <solver>
              <thread_position_correction>1</thread_position_correction>
              <island_threads>3</island_threads>
            </solver>
          </ode>
     </physics>
        
    <!-- Willow Garage building -->
    <include>
      <uri>model://Willow_Garage_HD</uri>
      <!-- Optional: pose if you want to shift it -->
      <!-- <pose>0 0 0 0 0 0</pose> -->
    </include>

    <!-- <include>
      <uri>model://OfficeChairBlack</uri>
      <pose>-1 -1 0 0 0 0</pose> 
    </include> -->

  </world>
</sdf>
